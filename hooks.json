{
  "safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/safety_guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "error-monitor": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/error_post_tool.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "./scripts/error_pre_invocation.sh",
        "timeout": 5
      }
    ]
  },
  "auto-formatter": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/auto_formatter.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "submodule-update-checker": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "./scripts/check_submodule_update.sh",
        "timeout": 5
      }
    ]
  },
  "doc-drift-reminder": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "./scripts/doc_drift_checker.sh",
        "timeout": 5
      }
    ]
  }
}
